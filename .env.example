# Server configuration
PORT=3000

# Google Gemini API key for dynamic Truth or Dare & drunk chatter
GEMINI_API_KEY=

# MongoDB connection string (REQUIRED — no in-memory fallback; APIs return 503 until connected)
MONGODB_URI=mongodb://localhost:27017/tram_nhau_online

# Redis (REQUIRED — sessions, presence & rate limits; no in-memory fallback). Use ONE of:
# 1) TCP connection string (local Redis, or Upstash "TCP" tab — note rediss:// for TLS)
REDIS_URL=redis://localhost:6379
# 2) Upstash "REST" tab (leave REDIS_URL empty/removed to use this)
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-rest-token>
