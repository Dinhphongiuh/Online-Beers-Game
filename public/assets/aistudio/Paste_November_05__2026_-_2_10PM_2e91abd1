// 3. HÀM DỰNG MODEL NHÂN VẬT THÚ BÔNG 3D CHIBI (THREE.JS PROCEDURAL PLUSHIE)
// ============================================================================
function createPlushieCharacterMesh(speciesConfig, hatId = 'none') {
  const root = new THREE.Group();

  const bodyMat = new THREE.MeshStandardMaterial({
    color: speciesConfig.bodyColor,
    roughness: 0.75
  });
  const bellyMat = new THREE.MeshStandardMaterial({
    color: speciesConfig.bellyColor,
    roughness: 0.8
  });
  const shirtMat = new THREE.MeshStandardMaterial({
    color: speciesConfig.shirtColor,
    roughness: 0.65
  });
  const darkMat = new THREE.MeshStandardMaterial({ color: 0x111827, roughness: 0.3 });
  const blushMat = new THREE.MeshBasicMaterial({
    color: 0xf43f5e,
    transparent: true,
    opacity: 0.0
  });

  // Torso (Thân trên mềm oặt để lắc lư theo độ say)
  const torsoPivot = new THREE.Group();
  torsoPivot.position.set(0, 0.95, 0);
  root.add(torsoPivot);

  // Thân chính
  const torsoGeo = new THREE.SphereGeometry(0.55, 20, 20);
  torsoGeo.scale(1, 1.12, 0.92);
  const torsoMesh = new THREE.Mesh(torsoGeo, bodyMat);
  torsoMesh.castShadow = true;
  torsoPivot.add(torsoMesh);

  // Áo ba lỗ / Áo sơ mi
  const shirtGeo = new THREE.CylinderGeometry(0.52, 0.56, 0.52, 20);
  const shirtMesh = new THREE.Mesh(shirtGeo, shirtMat);
  shirtMesh.position.set(0, 0.12, 0);
  torsoPivot.add(shirtMesh);

  // Bụng Bia (Scale to ra theo chỉ số Bladder / Beer Belly)
  const bellyGeo = new THREE.SphereGeometry(0.42, 18, 18);
  const bellyMesh = new THREE.Mesh(bellyGeo, bellyMat);
  bellyMesh.position.set(0, -0.12, 0.28);
  torsoPivot.add(bellyMesh);

  // Đầu Chibi
