// Hàm biến đổi văn bản chat theo Độ Cồn (Alcohol Text Mutator)
function mutateDrunkText(rawText, alcoholLevel) {
  if (!rawText) return { text: '', style: 'NORMAL', replaced: false };

  if (alcoholLevel <= 30) {
    return { text: rawText, style: 'NORMAL', replaced: false };
  }

  if (alcoholLevel <= 65) {
    const slurred = rawText
      .replace(/([aăâeêioôơuưy])/gi, (m, p1, offset) => (offset % 2 === 0 ? m.repeat(3) : m))
      .replace(/\s+/g, (m, offset) => (offset % 3 === 0 ? ' ...ực... ' : ' '));
    return { text: slurred + ' 🍺', style: 'TIPSY', replaced: false };
  }

  if (/về|nghỉ|thôi|ngủ/i.test(rawText)) {
    return {
      text: "Về là về thế nào?! Hôm nay không say không về! 🍺🔥",
      style: 'WASTED',
      replaced: true
    };
  }
  if (/tiền|bill|hóa đơn|trả/i.test(rawText)) {
    return {
      text: "Tiền bạc tầm này quan trọng gì! Để tao... ủa ví tao đâu rồi?! 💸",
      style: 'WASTED',
      replaced: true
    };
  }

  if (Math.random() < 0.78 || alcoholLevel >= 85) {
    const randomQuote = DRUNK_QUOTES[Math.floor(Math.random() * DRUNK_QUOTES.length)];
    return { text: randomQuote, style: 'WASTED', replaced: true };
  }

  const chaotic =
    rawText
      .split('')
      .map((c, i) => (i % 2 === 0 ? c.toUpperCase() : c.toLowerCase()))
      .join('') + ' ...ợ... 🥴🌀';
  return { text: chaotic, style: 'WASTED', replaced: false };
}

