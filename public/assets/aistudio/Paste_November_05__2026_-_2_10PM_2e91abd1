    towerFoam.position.y = 1.15;
    towerGroup.add(towerBase, towerGlass, towerFoam);
    tableGroup.add(towerGroup);

    // 2. Đĩa Đậu Phộng Rang Muối & Chân Gà Nướng
    const plateMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, roughness: 0.3 });
    const plate = new THREE.Mesh(new THREE.CylinderGeometry(0.42, 0.32, 0.05, 20), plateMat);
    plate.position.set(-0.62, 1.24, 0.45);
    tableGroup.add(plate);

    const peanutMat = new THREE.MeshStandardMaterial({ color: 0xd97706, roughness: 0.8 });
    for (let i = 0; i < 14; i++) {
      const p = new THREE.Mesh(new THREE.SphereGeometry(0.055, 8, 8), peanutMat);
      p.scale.set(1.3, 0.8, 0.9);
      p.position.set(
        -0.62 + (Math.random() - 0.5) * 0.42,
        1.29 + Math.random() * 0.05,
        0.45 + (Math.random() - 0.5) * 0.42
      );
      tableGroup.add(p);
    }

    // 3. Xô Đá Inox & Khăn Lạnh
    const iceBucket = new THREE.Mesh(new THREE.CylinderGeometry(0.26, 0.2, 0.38, 18), inoxMat);
    iceBucket.position.set(0.68, 1.41, -0.45);
    tableGroup.add(iceBucket);

    // --- 4 GHẾ ĐẨU NHỰA ĐỎ QUỐC DÂN & 4 NHÂN VẬT THÚ BÔNG 3D ---
    const seatCoords = [
      { x: -1.85, z: 1.35, rotY: Math.PI * 0.32 }, // Ghế 0: Người chơi chính (Trái trước)
      { x: -1.65, z: -1.35, rotY: Math.PI * 0.68 }, // Ghế 1: Hùng Đại Ca (Trái sau)
      { x: 1.65, z: -1.35, rotY: -Math.PI * 0.68 }, // Ghế 2: Phong Lươn Lẹo (Phải sau)
      { x: 1.85, z: 1.35, rotY: -Math.PI * 0.32 } // Ghế 3: Vịt Chiếu Mới (Phải trước)
    ];

    const redPlasticMat = new THREE.MeshStandardMaterial({ color: 0xdc2626, roughness: 0.4 });
    const builtChars = [];

    seatCoords.forEach((sc, idx) => {
      const seatAnchor = new THREE.Group();
      seatAnchor.position.set(sc.x, 0, sc.z);
      seatAnchor.rotation.y = sc.rotY;
      scene.add(seatAnchor);

      // Ghế đẩu nhựa đỏ có lỗ tròn ở giữa
      const stoolTop = new THREE.Mesh(new THREE.BoxGeometry(0.76, 0.08, 0.76), redPlasticMat);
      stoolTop.position.y = 0.62;
      stoolTop.castShadow = true;
      seatAnchor.add(stoolTop);

      [
        [-0.3, -0.3],
        [0.3, -0.3],
        [-0.3, 0.3],
