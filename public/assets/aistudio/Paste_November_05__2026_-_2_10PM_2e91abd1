      ].forEach(([sx, sz]) => {
        const sLeg = new THREE.Mesh(
          new THREE.CylinderGeometry(0.045, 0.06, 0.62, 8),
          redPlasticMat
        );
        sLeg.position.set(sx, 0.31, sz);
        seatAnchor.add(sLeg);
      });

      // Dựng Model Nhân vật Thú Bông 3D
      const initialSeat = stateBridgeRef.current.seats[idx];
      const charObj = createPlushieCharacterMesh(
        initialSeat.species,
        idx === 0 ? selectedHat : 'none'
      );
      charObj.root.position.y = 0.08;
      charObj.seatAnchor = seatAnchor;
      charObj.basePos = new THREE.Vector3(sc.x, 0, sc.z);
      charObj.baseRotY = sc.rotY;
      charObj.knockbackVel = 0;
      seatAnchor.add(charObj.root);
      builtChars.push(charObj);
    });

    charsRef.current = builtChars;

    // --- XE MÁY CHẠY VỤT QUA NGOÀI ĐƯỜNG PHÍA SAU ---
    const bikeGroup = new THREE.Group();
    const bikeBody = new THREE.Mesh(
      new THREE.BoxGeometry(1.4, 0.65, 0.45),
      new THREE.MeshStandardMaterial({ color: 0xef4444 })
    );
    bikeBody.position.y = 0.5;
    const headlight = new THREE.PointLight(0xfef08a, 2.2, 8);
    headlight.position.set(0.8, 0.7, 0);
    bikeGroup.add(bikeBody, headlight);
    bikeGroup.position.set(-18, 0, -6.5);
    scene.add(bikeGroup);

    // --- XỬ LÝ KÉO CHUỘT XOAY CAMERA 360 ĐỘ ---
    let isDragging = false;
    let prevX = 0;
    const onPointerDown = (e) => {
      isDragging = true;
      prevX = e.clientX;
    };
    const onPointerMove = (e) => {
      if (!isDragging) return;
      const dx = e.clientX - prevX;
      prevX = e.clientX;
      stateBridgeRef.current.orbitYaw -= dx * 0.0065;
    };
    const onPointerUp = () => {
      isDragging = false;
    };

    const domElem = renderer.domElement;
    domElem.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);

    // --- VÒNG LẶP ANIMATION 60 FPS (RAGDOLL PHYSICS + PARTICLES + CAMERA LERP) ---
    const clock = new THREE.Clock();
    let frameId;
    let lastBubbleSync = 0;

    const targetCamPos = new THREE.Vector3();
    const targetLookAt = new THREE.Vector3();
    const currentLookAt = new THREE.Vector3(0, 1.4, 0);

    const animate = () => {
      frameId = requestAnimationFrame(animate);
      const elapsed = clock.getElapsedTime();
      const bridge = stateBridgeRef.current;

      // 1. Điều khiển Góc Nhìn Camera (Lobby / Wardrobe / Minigame / Brawl + Độ Say)
      const drunkFactor = Math.max(0, (bridge.alcoholLevel - 30) / 70); // 0 -> 1
      const swayX = Math.sin(elapsed * 2.1) * drunkFactor * 0.42;
      const swayY = Math.cos(elapsed * 1.6) * drunkFactor * 0.25;

      if (bridge.cameraMode === 'WARDROBE_CAM') {
        targetCamPos.set(-3.4, 2.5, 3.3);
        targetLookAt.set(-1.85, 1.45, 1.35);
      } else if (bridge.cameraMode === 'MINIGAME_CAM') {
        targetCamPos.set(0, 5.4, 2.6);
        targetLookAt.set(0, 1.25, 0);
      } else if (bridge.cameraMode === 'BRAWL_CAM' || bridge.isTableFlipped) {
        targetCamPos.set(Math.sin(elapsed * 0.5) * 2.5, 6.2, 9.2);
        targetLookAt.set(0, 1.8, 0);
      } else {
        // LOBBY_CAM có hỗ trợ xoay chuột 360 độ
        const radius = bridge.isCheersClinking ? 5.6 : 7.6;
        const yaw = bridge.orbitYaw;
        targetCamPos.set(
          Math.sin(yaw) * radius + swayX,
          (bridge.isCheersClinking ? 3.8 : 4.8) + swayY,
          Math.cos(yaw) * radius
        );
        targetLookAt.set(swayX * 0.4, 1.45, 0);
      }

      camera.position.lerp(targetCamPos, 0.06);
      currentLookAt.lerp(targetLookAt, 0.08);
      camera.lookAt(currentLookAt);

      // 2. Hiệu ứng Đèn Loa Kẹo Kéo hoặc Còi Công An Phường
      if (bridge.karaokeDisco) {
        neonLeftLight.color.setHSL((elapsed * 0.8) % 1, 0.9, 0.55);
        neonRightLight.color.setHSL(((elapsed * 0.8) + 0.5) % 1, 0.9, 0.55);
        neonLeftLight.intensity = 3.2;
        neonRightLight.intensity = 3.2;
      } else if (bridge.policeSiren) {
        const isRed = Math.floor(elapsed * 8) % 2 === 0;
        neonLeftLight.color.setHex(isRed ? 0xff0000 : 0x0044ff);
        neonRightLight.color.setHex(isRed ? 0x0044ff : 0xff0000);
        neonLeftLight.intensity = 4.0;
        neonRightLight.intensity = 4.0;
      } else {
        neonLeftLight.color.setHex(0xf43f5e);
        neonRightLight.color.setHex(0x38bdf8);
        neonLeftLight.intensity = 1.5;
        neonRightLight.intensity = 1.4;
      }

      // 3. Hoạt ảnh Ragdoll của 4 Nhân Vật theo Độ Cồn & Bụng Bia
      charsRef.current.forEach((ch, idx) => {
        const seatInfo = bridge.seats[idx];
        ch.root.visible = seatInfo.occupied;
        if (!seatInfo.occupied) return;

        const charAlcohol = idx === 0 ? bridge.alcoholLevel : Math.min(95, bridge.alcoholLevel * 0.85 + 15);
        const wobbleAmp = (charAlcohol / 100) * 0.35;

        // Má hồng đỏ ửng khi say
        ch.blushMat.opacity = Math.min(0.85, Math.max(0, (charAlcohol - 25) / 60));

        // Bụng Bia phình to theo chỉ số Bladder
        const bellyScale = idx === 0 ? 1 + (bridge.bladderLevel / 100) * 0.75 : 1.15;
        ch.bellyMesh.scale.set(bellyScale, bellyScale, bellyScale);

        // Giấy Note dán trán
        ch.stickyNoteMesh.visible = seatInfo.hasStickyNote || (idx === 0 && selectedHat === 'sticky_note');

        // Phản lực khi bị Dép Tổ Ong hoặc Đậu Phộng ném trúng đầu
        if (ch.knockbackVel > 0.01) {
          ch.torsoPivot.rotation.x = -ch.knockbackVel;
          ch.knockbackVel *= 0.88;
        } else if (charAlcohol >= 95 || seatInfo.slumped) {
          // Gục mặt xuống bàn Inox hoặc ngã ngửa ra sau ghế nhựa
          ch.torsoPivot.rotation.x = THREE.MathUtils.lerp(ch.torsoPivot.rotation.x, 1.05, 0.08);
          ch.torsoPivot.rotation.z = Math.sin(elapsed * 1.2 + idx) * 0.15;
        } else if (bridge.isCheersClinking) {
          // Nghiêng người về tâm bàn cụng ly "1, 2, 3 DZÔ!"
          ch.torsoPivot.rotation.x = THREE.MathUtils.lerp(ch.torsoPivot.rotation.x, 0.42, 0.15);
          ch.rightArmPivot.rotation.x = THREE.MathUtils.lerp(ch.rightArmPivot.rotation.x, -0.85, 0.18);
        } else {
          // Lắc lư Ragdoll tự nhiên trên ghế nhựa đỏ
          ch.torsoPivot.rotation.x = Math.sin(elapsed * 2.4 + idx * 1.7) * wobbleAmp;
          ch.torsoPivot.rotation.z = Math.cos(elapsed * 1.9 + idx * 2.1) * wobbleAmp * 1.2;
          ch.headGroup.rotation.z = Math.sin(elapsed * 3.1 + idx) * (0.08 + wobbleAmp * 0.5);
          ch.rightArmPivot.rotation.x = Math.sin(elapsed * 2.8 + idx) * 0.22;
        }
      });

      // 4. Hiệu ứng LẬT BÀN INOX (TABLE FLIP PHYSICS)
      if (tableGroupRef.current) {
        if (bridge.isTableFlipped) {
          tableGroupRef.current.position.y = THREE.MathUtils.lerp(
            tableGroupRef.current.position.y,
            2.4,
            0.12
          );
          tableGroupRef.current.rotation.z = THREE.MathUtils.lerp(
            tableGroupRef.current.rotation.z,
            1.65,
            0.1
          );
          tableGroupRef.current.rotation.x = THREE.MathUtils.lerp(
            tableGroupRef.current.rotation.x,
            0.55,
            0.1
          );
        } else {
          tableGroupRef.current.position.y = THREE.MathUtils.lerp(
            tableGroupRef.current.position.y,
            0,
            0.12
          );
          tableGroupRef.current.rotation.z = THREE.MathUtils.lerp(
            tableGroupRef.current.rotation.z,
            0,
            0.12
          );
          tableGroupRef.current.rotation.x = THREE.MathUtils.lerp(
            tableGroupRef.current.rotation.x,
            0,
            0.12
          );
        }
      }

      // 5. Cập nhật Đạn Vật Lý 3D (Đậu phộng, Dép tổ ong, Đá lạnh bay qua bàn)
      for (let i = projectilesRef.current.length - 1; i >= 0; i--) {
        const proj = projectilesRef.current[i];
        proj.t += 0.045;
        if (proj.t >= 1) {
          // Trúng mục tiêu -> Tạo phản lực giật ngửa đầu Ragdoll
          const targetChar = charsRef.current[proj.targetIdx];
          if (targetChar) {
            targetChar.knockbackVel = 0.85;
          }
          sfx.playSlap();
          scene.remove(proj.mesh);
          projectilesRef.current.splice(i, 1);
        } else {
          proj.mesh.position.lerpVectors(proj.start, proj.end, proj.t);
          proj.mesh.position.y += Math.sin(proj.t * Math.PI) * 1.45; // Quỹ đạo Parabol
          proj.mesh.rotation.x += 0.25;
          proj.mesh.rotation.z += 0.2;
        }
      }

      // 6. Cập nhật Hạt Bọt Bia Văng Tung Tóe (Foam Splash Particles)
      for (let i = particlesRef.current.length - 1; i >= 0; i--) {
        const p = particlesRef.current[i];
        p.mesh.position.add(p.vel);
        p.vel.y -= 0.008;
        p.life -= 0.025;
        p.mesh.scale.setScalar(Math.max(0.01, p.life));
        if (p.life <= 0) {
          scene.remove(p.mesh);
          particlesRef.current.splice(i, 1);
        }
      }

      // 7. Xe máy chạy vụt qua ngoài đường
      bikeGroup.position.x += 0.16;
      if (bikeGroup.position.x > 22) bikeGroup.position.x = -22;

      renderer.render(scene, camera);

      // 8. Đồng bộ tọa độ 3D của đầu nhân vật sang tọa độ 2D cho Bong bóng Chat (20 lần/giây)
      if (elapsed - lastBubbleSync > 0.05) {
        lastBubbleSync = elapsed;
        const nextCoords = charsRef.current.map((ch, idx) => {
          if (!bridge.seats[idx].occupied) return { x: 0, y: 0, visible: false };
          const worldPos = new THREE.Vector3();
          ch.headGroup.getWorldPosition(worldPos);
          worldPos.y += 0.88 + bridge.seats[idx].cansOnHead * 0.22;
          worldPos.project(camera);
          const x = (worldPos.x * 0.5 + 0.5) * container.clientWidth;
          const y = (-(worldPos.y * 0.5) + 0.5) * container.clientHeight;
          return { x, y, visible: worldPos.z < 1 };
        });
        setBubbleCoords(nextCoords);
      }
    };

    animate();

    // Resize Handler
    const handleResize = () => {
      if (!container) return;
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    };
    window.addEventListener('resize', handleResize);

    return () => {
      cancelAnimationFrame(frameId);
      domElem.removeEventListener('pointerdown', onPointerDown);
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
    };
  }, []);

  // Cập nhật Skin / Màu áo / Phụ kiện của Nhân vật số 0 trong thời gian thực
  useEffect(() => {
    const playerChar = charsRef.current[0];
    if (!playerChar) return;
    playerChar.bodyMat.color.setHex(selectedSpecies.bodyColor);
    playerChar.shirtMat.color.set(customShirtHex);
    playerChar.stickyNoteMesh.visible = selectedHat === 'sticky_note' || seats[0].hasStickyNote;
  }, [selectedSpecies, customShirtHex, selectedHat, seats]);

  // ==========================================================================
  // 6. CÁC HÀNH ĐỘNG VẬT LÝ 3D TRÊN BÀN NHẬU (SANDBOX ACTIONS)
  // ==========================================================================

  // Tạo hiệu ứng bọt bia văng tung tóe ở tâm bàn 3D
  const spawnFoamSplash3D = () => {
    const scene = sceneRef.current;
    if (!scene) return;
    const foamMat = new THREE.MeshBasicMaterial({ color: 0xfef08a });
    for (let i = 0; i < 28; i++) {
      const drop = new THREE.Mesh(new THREE.SphereGeometry(0.07, 6, 6), foamMat);
      drop.position.set(0, 2.0, 0);
      scene.add(drop);
      particlesRef.current.push({
        mesh: drop,
        vel: new THREE.Vector3(
          (Math.random() - 0.5) * 0.18,
          Math.random() * 0.16 + 0.06,
          (Math.random() - 0.5) * 0.18
        ),
        life: 1.0
      });
    }
  };

  // 1. Hô "1, 2, 3 DZÔ!" — Cả bàn nghiêng người cụng ly 3D + Tăng cồn & Bụng bia
  const handleCheersClink3D = () => {
