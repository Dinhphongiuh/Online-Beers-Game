    ].forEach(([lx, lz]) => {
      const leg = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.04, 1.18, 10), inoxMat);
      leg.position.set(lx, 0.59, lz);
      leg.castShadow = true;
      tableGroup.add(leg);
    });

    // 1. Tháp Bia Tươi 3 Lít (Phát sáng vàng óng ở tâm bàn)
    const towerGroup = new THREE.Group();
    towerGroup.position.set(0, 1.22, 0);
    const towerBase = new THREE.Mesh(
      new THREE.CylinderGeometry(0.24, 0.28, 0.18, 18),
